<section class="page-shell archive-page">
  <header class="page-heading">
    <h1>Archive</h1>
    <p data-archive-summary data-total="<%= site.posts.length %>"><%= site.posts.length %> 篇关于技术、阅读与生活的记录。</p>
  </header>
  <div class="archive-filter">
    <span>按标签浏览</span>
    <ul class="archive-tag-list">
      <li><a href="<%- url_for('/archives/') %>" data-archive-tag="">全部</a></li>
      <% site.tags.sort('name').each(function(tag) { %>
        <li>
          <a href="<%- url_for('/archives/') %>?tag=<%- encodeURIComponent(tag.name) %>" data-archive-tag="<%- encodeURIComponent(tag.name) %>">#<%- tag.name %></a>
          <span class="archive-tag-list-count"><%= tag.length %></span>
        </li>
      <% }) %>
    </ul>
  </div>
  <div class="archive-list">
    <%
      let currentYear = null;
      site.posts.sort('date', -1).each(function(item) {
        const year = item.date.year();
        if (year !== currentYear) {
          if (currentYear !== null) { %></div></section><% }
          currentYear = year;
    %>
      <section class="archive-year">
        <div class="archive-year-label"><span><%- year %></span></div>
        <div class="archive-year-posts">
    <% } %>
          <article class="archive-row" data-tags="<%- item.tags.map(function(tag) { return encodeURIComponent(tag.name); }).join(',') %>">
            <time><%- item.date.format('MM.DD') %></time>
            <h2><a href="<%- url_for(item.path) %>"><%- item.title || 'Untitled' %></a></h2>
            <% if (item.tags && item.tags.length) { %><span><%- item.tags.first().name %></span><% } %>
          </article>
    <% }); if (currentYear !== null) { %></div></section><% } %>
  </div>
  <p class="archive-empty" hidden>没有找到这个标签下的文章。</p>
</section>
