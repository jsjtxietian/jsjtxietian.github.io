<section class="home-hero page-shell">
  <h1><%- theme.home.title %></h1>
  <p class="hero-description"><%- theme.home.description %></p>
</section>

<section class="post-feed page-shell" aria-labelledby="recent-heading">
  <header class="section-header">
    <h2 id="recent-heading">Recent writing</h2>
    <a href="<%- url_for('/archives/') %>">View archive <span aria-hidden="true">↗</span></a>
  </header>
  <div class="post-list">
    <% page.posts.each(function(item) { %>
      <article class="post-row">
        <time datetime="<%- item.date.format('YYYY-MM-DD') %>"><%- item.date.format('YYYY.MM.DD') %></time>
        <div class="post-row-main">
          <h3><a href="<%- url_for(item.path) %>"><%- item.title || 'Untitled' %></a></h3>
          <% if (item.tags && item.tags.length) { %>
            <div class="post-row-tags">
              <% item.tags.each(function(tag) { %><span><%- tag.name %></span><% }) %>
            </div>
          <% } %>
        </div>
        <a class="row-arrow" href="<%- url_for(item.path) %>" tabindex="-1" aria-hidden="true">↗</a>
      </article>
    <% }) %>
  </div>
  <%- partial('_partial/pagination') %>
</section>
