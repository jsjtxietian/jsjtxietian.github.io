<% if (theme.search.enable) { %>
<div class="search-dialog" role="dialog" aria-modal="true" aria-label="Site search" aria-hidden="true" data-search-path="<%- url_for(theme.search.path) %>">
  <div class="search-panel">
    <div class="search-field">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
      <input id="site-search-input" type="search" autocomplete="off" placeholder="<%- theme.search.placeholder %>" aria-label="Search">
      <kbd>ESC</kbd>
    </div>
    <div class="search-results" aria-live="polite">
      <div class="search-empty">Type to search across all posts.</div>
    </div>
  </div>
</div>
<% } %>
