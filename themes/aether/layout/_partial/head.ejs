<%
  let documentTitle = config.title;
  if (page.title) documentTitle = page.title + ' · ' + config.title;
  const description = page.description || page.ogdescription
    || (is_post() ? post_summary(page, 140) : '')
    || config.description || theme.home.description;
  const canonical = full_url_for(page.path || '/').replace(/index\.html$/, '');
%>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="author" content="<%= config.author %>">
  <meta name="description" content="<%= description %>">
  <meta name="theme-color" content="<%- theme.accent %>">
  <title><%- documentTitle %></title>
  <link rel="canonical" href="<%= canonical %>">
  <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
  <meta property="og:site_name" content="<%= config.title %>">
  <meta property="og:title" content="<%= page.title || config.title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:image" content="<%= full_url_for('/images/Sun.png') %>">
  <% if (is_post()) { %><meta property="article:published_time" content="<%= page.date.toISOString() %>"><% } %>
  <meta name="twitter:card" content="summary">
  <script>(function(){var t;try{t=localStorage.getItem('aether-theme')}catch(e){}if(t!=='light'&&t!=='dark')t=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';document.documentElement.dataset.theme=t})();</script>
  <link rel="icon" href="<%- url_for('/images/Sun.png') %>" type="image/png">
  <link rel="apple-touch-icon" href="<%- url_for('/images/Sun.png') %>">
  <link rel="alternate" type="application/atom+xml" title="<%- config.title %>" href="<%- url_for('/atom.xml') %>">
  <link rel="stylesheet" href="<%- url_for('/css/aether.css') %>">
  <% if ((page.content || '').includes('rel="footnote"')) { %>
    <link rel="stylesheet" href="<%- url_for('/css/footnotes.css') %>">
  <% } %>
  <% if (theme.mathjax.enable && is_post() && needs_math(page)) { %>
    <script>window.MathJax={tex:{inlineMath:[['$','$'],['\\(','\\)']]},svg:{fontCache:'global'},startup:{elements:['.prose']}};</script>
    <script async src="https://cdn.jsdelivr.net/npm/mathjax@3.2.2/es5/tex-svg.js"></script>
  <% } %>
</head>
