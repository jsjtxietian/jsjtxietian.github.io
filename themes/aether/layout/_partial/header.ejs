<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="<%- url_for('/') %>" aria-label="<%- config.title %> home">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name"><%- theme.nickname || config.author %></span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Primary navigation">
      <% theme.nav.forEach(function(item) { 
        const currentPath = page.path ? '/' + page.path : '/';
        const active = item.path === '/' ? is_home() : currentPath.startsWith(item.path);
      %>
        <a href="<%- url_for(item.path) %>" class="nav-link<%= active ? ' is-active' : '' %>"><%- item.name %></a>
      <% }) %>
    </nav>

    <div class="header-actions">
      <% if (theme.search.enable) { %>
        <button class="icon-button search-trigger" type="button" aria-label="Open search" aria-keyshortcuts="Control+K Meta+K" title="Search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
          <kbd aria-hidden="true">Ctrl K</kbd>
        </button>
      <% } %>
      <button class="icon-button theme-toggle" type="button" aria-label="Switch to dark theme" title="Toggle theme">
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg>
      </button>
      <button class="menu-toggle" type="button" aria-label="Toggle navigation" aria-controls="site-nav" aria-expanded="false">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>
