<% if (page.total > 1) { %>
<nav class="pagination" aria-label="Pagination">
  <span class="pagination-count"><%= String(page.current).padStart(2, '0') %> / <%= String(page.total).padStart(2, '0') %></span>
  <div>
    <% if (page.prev !== 0) { %><a href="<%- url_for(page.prev_link) %>" aria-label="Previous page"><span>←</span> Previous</a><% } %>
    <% if (page.next !== 0) { %><a href="<%- url_for(page.next_link) %>" aria-label="Next page">Next <span>→</span></a><% } %>
  </div>
</nav>
<% } %>
